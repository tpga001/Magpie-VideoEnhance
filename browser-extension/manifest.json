{
  "manifest_version": 3,
  "name": "Magpie 浏览器视频增强",
  "description": "自动识别前台主视频，使用 Magpie 当前浏览器模式进行超分和补帧。",
  "version": "0.2.4",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [{
    "resources": ["frame-relay.html", "frame-relay.js"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "action": {
    "default_title": "Magpie 视频增强",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["video-geometry.js", "frame-packet.js", "frame-relay-client.js", "decoded-frames.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
